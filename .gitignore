# Dependencies
node_modules/

docs/specs/

# Build output
dist/
build/
out/

# Environment files — ignore all .env variants, but allow example files
.env
.env.*
!.env.example
apps/**/.env
apps/**/.env.*
!apps/**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# Test and coverage output
coverage/
.nyc_output/

# Caches
.cache/
.turbo/

# TypeScript
*.tsbuildinfo

# SQLite / libSQL local database files
*.db
*.db-shm
*.db-wal
# Local libSQL dev database artifacts (extensionless, created by `bun run dev`)
apps/server/dev
apps/server/dev-wal
apps/server/dev-shm

# Temporary files
.tmp/

# Rust build artifacts
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/Cargo.lock

# Tauri icon generation artifacts
apps/desktop/src-tauri/icons/icon.iconset/

# TanStack router tmp files
apps/web/.tanstack/tmp/

# OS files
.DS_Store

# Weave runtime/session files — ephemeral, not for version control
.weave/runtime/
.weave/state.json

