# =============================================================================
# apps/web — environment variables
# Copy this file to .env.local and fill in values for local development.
# Never commit .env or .env.local files.
# =============================================================================

# API base URL (build-time, Vite client bundle)
# Vite exposes VITE_* variables to the browser via import.meta.env.
#
# Staging / Production / Preview values come from the ECS Express Terraform
# output URL — format: https://<service>.ecs.us-east-1.on.aws
# Do NOT use api.<zone> — use the ECS-generated URL directly.
#
# Examples:
#   Local dev  → http://localhost:3000
#   Staging    → https://<staging-service>.ecs.us-east-1.on.aws
#   Production → https://<prod-service>.ecs.us-east-1.on.aws
#   Preview    → https://<pr-service>.ecs.us-east-1.on.aws
VITE_API_BASE_URL=http://localhost:3000
