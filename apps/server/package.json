{
  "name": "@hay/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:server": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "test": "bun test src/services/sync/state.test.ts src/services/sync/runs.test.ts src/services/sync/orchestrator.test.ts",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "dev:db": "bunx --bun turso dev --db-file local.db"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/html": "^1.4.0",
    "@elysiajs/server-timing": "^1.4.0",
    "@elysiajs/static": "^1.4.6",
    "@elysiajs/swagger": "^1.3.1",
    "@kitajs/html": "^4.2.0",
    "@libsql/client": "^0.17.3",
    "@verrou/core": "^0.5.1",
    "better-auth": "^1.6.11",
    "bullmq": "^5.77.6",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.16",
    "elysia-autoload": "^1.7.0",
    "env-var": "^7.5.0",
    "ioredis": "^5.8.2",
    "jobify": "^0.1.6",
    "posthog-node": "^5.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@kitajs/ts-html-plugin": "^4.1.3",
    "@types/bun": "^1.3.2",
    "drizzle-kit": "^0.31.7",
    "typescript": "^5.9.3"
  }
}
