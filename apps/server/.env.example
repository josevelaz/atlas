# ─────────────────────────────────────────────
# Database (libSQL / Turso)
# ─────────────────────────────────────────────

# Local development: leave unset to use the Turso CLI local server (http://127.0.0.1:8080).
# Remote Turso Cloud: set to your database URL (e.g. libsql://your-db.turso.io).
# DATABASE_URL=http://127.0.0.1:8080

# Required when DATABASE_URL points to a remote libSQL database.
# Not needed for the local Turso CLI server.
# DATABASE_AUTH_TOKEN=

# ─────────────────────────────────────────────
# Better Auth
# ─────────────────────────────────────────────

# REQUIRED. Random secret used to sign sessions and tokens.
# Generate with: openssl rand -base64 32
# Never commit the real value. Rotate if leaked.
BETTER_AUTH_SECRET=

# The canonical URL of this API server (no trailing slash).
# Local default: http://localhost:3000
# PRODUCTION: must be an HTTPS URL (e.g. https://api.hay.example.com).
#   The app will refuse to start in NODE_ENV=production with a localhost URL.
BETTER_AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────

# Comma-separated list of allowed frontend origins (full scheme + host, no trailing slash).
#
# Local default (when unset):
#   http://localhost:3000,http://localhost:3001,http://localhost:5173
#   + tauri://localhost (macOS/Linux desktop)
#   + https://tauri.localhost (Windows desktop)
#
# PRODUCTION: set to your real frontend origin(s) — no wildcards, no plain localhost.
#   The app will refuse to start in NODE_ENV=production with wildcard or localhost origins.
#   Tauri custom-protocol origins are always merged in automatically and are exempt from
#   the localhost-in-production check (they are desktop-only, not web-browser localhost).
#
# Staging example:
#   CORS_ALLOWED_ORIGINS=https://staging.hay.example.com
#
# Production example (web + staging + desktop):
#   CORS_ALLOWED_ORIGINS=https://hay.example.com,https://staging.hay.example.com
#
# PR preview deployments — set per-environment in your CI/CD system:
#   CORS_ALLOWED_ORIGINS=https://pr-123.preview.hay.example.com,https://hay.example.com
#   Use a deterministic URL pattern driven by the PR number or commit SHA.
#   Never use a wildcard (e.g. https://*.preview.hay.example.com) — wildcards are not
#   supported and credentials (cookies) must never be sent to a wildcard origin.
#
# Cross-site frontends (different domain from the API) that require SameSite=None cookies
# must also use HTTPS and should receive an explicit CSRF review before going to production.
#
# CORS_ALLOWED_ORIGINS=https://hay.example.com

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────

# Port the HTTP server listens on. Defaults to 3000.
# PORT=3000

# Runtime environment. Defaults to "development".
# Values: development | test | production
# In ECS deployments this is always set to "production".
# NODE_ENV=development

# Hay-specific environment name. Distinguishes deployed environments when NODE_ENV=production.
# Values: development | staging | production | preview-pr-<N>
# Set automatically by Terraform (ECS module) for deployed environments.
# HAY_ENV=development

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────

# Redis host. Defaults to localhost.
# REDIS_HOST=localhost

# Redis port. Defaults to 6379.
# REDIS_PORT=6379

# Key prefix applied to all Redis keys. Useful for namespacing in shared clusters.
# Leave empty for local dev. Example for staging: "staging:"
# REDIS_KEY_PREFIX=

# Enable TLS for Redis connections (e.g. AWS ElastiCache in transit encryption).
# Set to "true" in production. Defaults to false.
# Note: ElastiCache IAM auth is handled at the AWS level — no token config needed here.
# REDIS_TLS=false

# ─────────────────────────────────────────────
# S3 / object storage
# ─────────────────────────────────────────────

# Target S3 bucket name. Defaults to "hay-local" for local dev.
# PRODUCTION: set to your real bucket name.
# S3_BUCKET=hay-local

# AWS region for the bucket. Defaults to "us-east-1".
# S3_REGION=us-east-1

# Optional key prefix applied to all object paths (e.g. "uploads/").
# Defaults to empty string (no prefix).
# S3_PREFIX=

# Optional custom endpoint — set for local MinIO or other S3-compatible stores.
# Leave unset in production to use the real AWS S3 endpoint.
# S3_ENDPOINT=http://localhost:9000

# Long-lived credentials — only needed for local dev / MinIO.
# In ECS/production, leave UNSET and rely on the ECS task-role credential chain.
# The AWS SDK will automatically use the task role when these are absent.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────
# Analytics (PostHog)
# ─────────────────────────────────────────────

# POSTHOG_API_KEY=
# POSTHOG_HOST=localhost

# ─────────────────────────────────────────────
# Public domain (used to derive API_URL)
# ─────────────────────────────────────────────

# PUBLIC_DOMAIN=hay.example.com

# API_URL overrides the derived URL. Required for local dev when using mailbox
# OAuth connect flows so Google can redirect back to the correct callback URI.
# LOCAL DEV: API_URL=http://localhost:3000
# API_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Social auth providers (Better Auth socialProviders)
# ─────────────────────────────────────────────
# Add credentials here when enabling a provider in src/auth.ts.
# Each provider needs its own client ID and secret from the provider's developer console.
# See: https://www.better-auth.com/docs/authentication/social-sign-on
#
# IMPORTANT: For mailbox OAuth connect flows (task 3.0), GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET must be set. The Google OAuth app must have these
# redirect URIs registered:
#   - http://localhost:3000/api/accounts/google/connect/callback  (web, local dev)
#   - http://localhost:3000/api/accounts/google/connect/desktop/callback  (desktop, local dev)
#   - https://<your-domain>/api/accounts/google/connect/callback  (web, production)
#   - https://<your-domain>/api/accounts/google/connect/desktop/callback  (desktop, production)

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Microsoft / Azure AD OAuth
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ─────────────────────────────────────────────
# Email sync infrastructure
# ─────────────────────────────────────────────

# Number of sync jobs a single worker processes concurrently.
# Higher values increase throughput but consume more Redis connections and memory.
# Defaults to 5. Tune upward in production based on instance size.
# SYNC_WORKER_CONCURRENCY=5

# Maximum delivery attempts before a sync job is moved to the dead-letter queue.
# Applies to all sync job types (initial, incremental). Defaults to 3.
# SYNC_MAX_ATTEMPTS=3

# Base delay in milliseconds for the first exponential-backoff retry.
# Subsequent retries double this value: delay × 2^(attempt-1). Defaults to 5000 (5 s).
# SYNC_BACKOFF_DELAY_MS=5000

# Jitter percentage (0–100) added to each backoff delay to spread retry storms.
# A value of 20 means ±20 % of the computed delay is added at random. Defaults to 20.
# Must be between 0 and 100 — values outside this range fail at startup.
# SYNC_BACKOFF_JITTER_PERCENT=20

# Time-to-live in milliseconds for distributed sync locks.
# A lock not renewed within this window is released for another worker. Defaults to 30000 (30 s).
# SYNC_LOCK_TTL_MS=30000

# Time-to-live in milliseconds for enqueue deduplication keys.
# Duplicate enqueue requests within this window are silently dropped. Defaults to 60000 (60 s).
# SYNC_ENQUEUE_DEDUPE_TTL_MS=60000

# Sliding-window duration in milliseconds for detecting duplicate enqueue requests.
# Requests for the same account within this window are collapsed into one job. Defaults to 30000 (30 s).
# SYNC_ENQUEUE_DEDUPE_WINDOW_MS=30000

# How often the reconciliation scheduler fires, in milliseconds.
# The reconciler catches accounts whose push/webhook triggers were missed.
# Defaults to 300000 (5 minutes). Must be at least 60000 (1 minute) — lower values fail at startup.
# SYNC_RECONCILIATION_CADENCE_MS=300000

# Whether the sync worker is enabled. Set to "false" in test environments to prevent
# background workers from interfering with unit/integration tests. Defaults to true.
# SYNC_WORKER_ENABLED=true

# Whether the sync scheduler (reconciliation cron) is enabled. Set to "false" in test
# environments to prevent scheduled jobs from firing during tests. Defaults to true.
# SYNC_SCHEDULER_ENABLED=true
