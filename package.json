{
  "name": "atlas",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:db": "turso dev --db-file local.db",
    "start": "NODE_ENV=production bun run ./src/index.ts",
    "lint": "bun x @biomejs/biome check src",
    "lint:fix": "bun lint --write",
    "generate": "bun x drizzle-kit generate",
    "push": "bun x drizzle-kit push",
    "migrate": "bun x drizzle-kit migrate",
    "studio": "bun x drizzle-kit studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/html": "^1.4.0",
    "@elysiajs/server-timing": "^1.4.0",
    "@elysiajs/static": "^1.4.6",
    "@elysiajs/swagger": "^1.3.1",
    "@kitajs/ts-html-plugin": "^4.1.3",
    "@libsql/client": "^0.17.3",
    "@verrou/core": "^0.5.1",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.16",
    "elysia-autoload": "^1.7.0",
    "env-var": "^7.5.0",
    "ioredis": "^5.8.2",
    "jobify": "^0.1.6",
    "posthog-node": "^5.11.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.2",
    "@biomejs/biome": "^2.3.5",
    "drizzle-kit": "^0.31.7",
    "husky": "^9.1.7"
  }
}
