{
  "name": "atlas",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build --filter=!@hay/desktop",
    "dev": "turbo run dev --filter=@hay/server --filter=@hay/web",
    "dev:server": "turbo run dev:server",
    "dev:web": "turbo run dev:web",
    "dev:desktop": "turbo run dev:desktop",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck --filter=!@hay/desktop",
    "dev:db": "turbo run dev:db --filter=@hay/server",
    "generate": "turbo run generate --filter=@hay/server",
    "push": "turbo run push --filter=@hay/server",
    "migrate": "turbo run migrate --filter=@hay/server",
    "studio": "turbo run studio --filter=@hay/server",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@tanstack/solid-start-client": "1.168.2",
    "husky": "^9.1.7",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  }
}
